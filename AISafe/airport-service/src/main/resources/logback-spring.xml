<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="INSTANCE" source="aisafe.instance-id" defaultValue="airport"/>

    <!-- Console: every line shows the replica and the correlation id of the request -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [${INSTANCE}] [%X{correlationId:--}] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Audit trail: one line per API call, kept in logs/audit-<instance>.log -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/audit-${INSTANCE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/audit-${INSTANCE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{ISO8601} correlationId=%X{correlationId:--} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="true">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
