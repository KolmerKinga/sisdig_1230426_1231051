    {
      "name": "1. Login (saves the tokens)",
      "item": [
        {
          "name": "Login admin (auth-1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth1}}/auth/login",
              "host": [
                "{{auth1}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"token received\", () => { pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
                  "pm.test(\"token saved in token_admin\", () => { pm.collectionVariables.set(\"token_admin\", pm.response.json().token); });"
                ]
              }
            }
          ]
        },
