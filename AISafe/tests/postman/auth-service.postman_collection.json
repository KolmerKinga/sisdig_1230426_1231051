    {
      "name": "2. Token validation",
      "item": [
        {
          "name": "GET /auth/me with the ATCC token (auth-1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_atcc}}"
              }
            ],
            "url": {
              "raw": "{{auth1}}/auth/me",
              "host": [
                "{{auth1}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"username atcc\", () => { pm.expect(pm.response.json().username).to.eql(\"atcc\"); });",
                  "pm.test(\"role ATCC\", () => { pm.expect(pm.response.json().roles).to.eql([\"ATCC\"]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me on auth-2 with a token issued by auth-1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_atcc}}"
              }
            ],
            "url": {
              "raw": "{{auth2}}/auth/me",
              "host": [
                "{{auth2}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "The token was issued by auth-1 and is validated by auth-2 with the shared key: no shared session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"validated by auth-2\", () => { pm.expect(pm.response.json().validatedBy).to.eql(\"auth-2\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
