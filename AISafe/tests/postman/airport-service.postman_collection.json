                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"X-Partial-Result = false\", () => pm.expect(pm.response.headers.get(\"X-Partial-Result\")).to.eql(\"false\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search all on airport-2 (aggregated from both replicas)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_atcc}}"
              }
            ],
            "url": {
              "raw": "{{airport2}}/api/airports?size=50"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"X-Partial-Result = false\", () => pm.expect(pm.response.headers.get(\"X-Partial-Result\")).to.eql(\"false\"));",
                  "pm.test(\"contains airports of both replicas\", () => { const codes = pm.response.json().map(a => a.iataCode); pm.expect(codes).to.include.members([\"OPO\",\"LIS\",\"MAD\",\"CDG\",\"LHR\",\"FAO\"]); });",
                  "pm.test(\"no duplicates\", () => { const codes = pm.response.json().map(a => a.iataCode); pm.expect(new Set(codes).size).to.eql(codes.length); });"
                ]
              }
            }
          ]
        },
