          ]
        }
      ]
    },
    {
      "name": "1. Local access",
      "item": [
        {
          "name": "GET OPO on airport-1 (stored locally)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_atcc}}"
              }
            ],
            "url": {
              "raw": "{{airport1}}/api/airports/OPO"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"X-Data-Source = local\", () => pm.expect(pm.response.headers.get(\"X-Data-Source\")).to.eql(\"local\"));",
                  "pm.test(\"X-Served-By = airport-1\", () => pm.expect(pm.response.headers.get(\"X-Served-By\")).to.eql(\"airport-1\"));",
                  "pm.test(\"iata OPO\", () => pm.expect(pm.response.json().iataCode).to.eql(\"OPO\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Forwarding and aggregation",
      "item": [
        {
          "name": "GET CDG on airport-1 (stored on airport-2 -> forwarded)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_atcc}}"
              }
            ],
            "url": {
              "raw": "{{airport1}}/api/airports/CDG"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"X-Served-By = airport-1\", () => pm.expect(pm.response.headers.get(\"X-Served-By\")).to.eql(\"airport-1\"));",
                  "pm.test(\"X-Data-Source contains 8092\", () => pm.expect(pm.response.headers.get(\"X-Data-Source\") || \"\").to.include(\"8092\"));",
                  "pm.test(\"iata CDG\", () => pm.expect(pm.response.json().iataCode).to.eql(\"CDG\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET XYZ (exists nowhere -> 404)",
