            "url": {
              "raw": "{{airport2}}/api/airports"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iataCode\": \"BCN\",\n  \"airportType\": \"International\",\n  \"name\": \"Josep Tarradellas Barcelona-El Prat Airport\",\n  \"status\": \"OPERATIONAL\",\n  \"operationalHours\": \"00:00-24:00\",\n  \"location\": {\n    \"city\": \"Barcelona\",\n    \"country\": \"Spain\",\n    \"region\": \"Catalonia\",\n    \"timezone\": \"Europe/Madrid\",\n    \"latitude\": 41.2974,\n    \"longitude\": 2.0833\n  },\n  \"facilities\": {\n    \"terminalCount\": 2,\n    \"gateCount\": 68,\n    \"services\": [\n      \"WiFi\",\n      \"Duty Free\"\n    ]\n  },\n  \"runways\": [\n    {\n      \"runwayName\": \"07L/25R\",\n      \"length\": 3352.0,\n      \"orientation\": \"Asphalt\",\n      \"status\": \"IN_USE\"\n    }\n  ],\n  \"certifications\": [\n    {\n      \"name\": \"ICAO Annex 14 Compliance\",\n      \"category\": \"SAFETY\",\n      \"startsAt\": \"2024-01-01\",\n      \"expiresAt\": \"2028-01-01\"\n    }\n  ],\n  \"contacts\": [\n    {\n      \"type\": \"EMAIL\",\n      \"value\": \"info@aena.es\"\n    }\n  ],\n  \"airportPhotos\": []\n}"
