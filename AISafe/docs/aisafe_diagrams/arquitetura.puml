@startuml
title AISafe Flight Management System\nDistributed Architecture - Container view (C4 Level 2)

left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam defaultFontName SansSerif
skinparam ArrowFontSize 11

actor "Client\n(Postman / Frontend)\nBackoffice, ATCC,\nMaintenance staff" as Client

package "Identity & Access (supporting)" as AuthPkg {
  component "auth-service\nSpring Boot - HTTPS\n8051 / 8052\n\nPOST /auth/login\nissues JWT (username, roles)" as Auth
  database "H2 per replica\nCollaborators" as AuthDB
  Auth --> AuthDB : JPA
}

package "Aircraft Management" as AircraftPkg {
  component "aircraft-service\nSpring Boot - HTTPS\n8081 / 8082\n\nAircraftModel, Aircraft,\nAircraftCertification" as Aircraft
  database "H2 per replica\naircraft1 / aircraft2" as AircraftDB
  Aircraft --> AircraftDB : JPA
}

package "Airport Management" as AirportPkg {
  component "airport-service\nSpring Boot - HTTPS\n8091 / 8092\n\nAirport, Runway,\nFacilities, Certification" as Airport
  database "H2 per replica\nairport1 / airport2" as AirportDB
  Airport --> AirportDB : JPA
}

package "Route / Flight Operations" as RoutePkg {
  component "route-flight-service\nSpring Boot - HTTPS\n8071 / 8072\n\nRoute, RouteHistory,\nFlight (scheduled flight)" as Route
  database "H2 per replica\nroute1 / route2" as RouteDB
  Route --> RouteDB : JPA
}

package "Maintenance Management" as MaintenancePkg {
  component "maintenance-service\nSpring Boot - HTTPS\n8061 / 8062\n\nMaintenanceTemplate,\nMaintenanceRecord" as Maintenance
  database "H2 per replica\nmaintenance1 / maintenance2" as MaintenanceDB
  Maintenance --> MaintenanceDB : JPA
}

Client --> Auth : HTTPS\nPOST /auth/login
Client --> Aircraft : HTTPS/REST + JWT
Client --> Airport : HTTPS/REST + JWT
Client --> Route : HTTPS/REST + JWT
Client --> Maintenance : HTTPS/REST + JWT

Route --> Aircraft : HTTPS/REST\nGET aircraft (status, range, capacity)\nPATCH flight hours
Route --> Airport : HTTPS/REST\nGET airport (status, certifications)
Route --> Maintenance : HTTPS/REST\nGET ongoing maintenance of aircraft
Maintenance --> Aircraft : HTTPS/REST\nGET aircraft (model, flight hours)\nPATCH availability (MAINTENANCE / AVAILABLE)

legend bottom left
  Arrows point from consumer to provider. Dependencies are acyclic:
  aircraft-service and airport-service never call other services.
  Each container runs as 2 independent replicas (separate JVM, port and H2 store).
  Replicas of the same service forward GET requests to each other (see deployment
  and forwarding diagrams). No shared database. No message queues (Assignment 1).
  Security: HTTPS on every port; user JWT validated locally by every service
  (shared signing key from environment); internal calls also carry X-Service-Key;
  role-based access control per endpoint; audit log per replica.
endlegend
@enduml
